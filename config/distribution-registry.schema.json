{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "verifiedAt", "followUpDays", "release", "statuses", "targets"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "followUpDays": {
      "type": "array",
      "prefixItems": [
        { "const": 7 },
        { "const": 14 },
        { "const": 30 }
      ],
      "items": false
    },
    "release": {
      "type": "object",
      "required": ["version", "endpoint", "repository", "widgetUri", "tools", "prompts", "authentication", "readOnly"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "candidateVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "statuses": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "status", "publicPage", "verifiedAt", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "listingUrl": { "type": ["string", "null"], "format": "uri" },
          "submissionUrl": { "type": ["string", "null"], "format": "uri" },
          "publicPage": { "type": "boolean" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "evidence": { "type": "string", "minLength": 1 },
          "verificationStatuses": {
            "type": "array",
            "items": { "type": "integer", "minimum": 100, "maximum": 599 }
          },
          "submission": {
            "type": "object",
            "required": ["submittedAt", "attempt", "evidenceUrl", "payload", "followUpAt"],
            "properties": {
              "submittedAt": { "type": "string", "format": "date-time" },
              "attempt": { "type": "integer", "minimum": 1 },
              "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
              "payload": { "type": "object" },
              "followUpAt": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "type": "string", "format": "date-time" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
